# Copy this file to .env, fill the values locally, and never commit the filled .env.
# Example: generate a long unique password with `openssl rand -hex 32`.
# Compose passes it as PGPASSWORD separately from DATABASE_URL, so URI-reserved characters are safe too.
POSTGRES_PASSWORD=

# Compose is production-shaped by default. Keep this as production behind HTTPS.
# Use development only on an isolated local machine; production OAuth requires HTTPS.
APP_ENV=production
WEB_BIND=127.0.0.1
WEB_PORT=3000

# The backend requires a non-empty list whenever DATABASE_URL is configured.
# Comma-separated Manus openIds; server-only. Do not use names or email addresses.
APP_ALLOWED_OPEN_IDS=

# OAuth server-side values. Manus Preview injects its own values; Vercel or an internal
# deployment does not inherit them automatically. Never prefix these with NEXT_PUBLIC_.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=

# Exact external HTTPS origin in production, for example https://projects.example.com
PUBLIC_APP_ORIGIN=
