# Copy to .env, fill the values locally, and never commit it.
# Generate a strong database password, for example: openssl rand -hex 32.
POSTGRES_PASSWORD=
APP_ENV=production
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Exact external origin. Production requires HTTPS, e.g. https://projects.example.com.
PUBLIC_APP_ORIGIN=
# Required by the AI assistant route when using the configured Gemini model.
# Add it in Vercel Project Settings > Environment Variables for Production and Preview.
AI_GATEWAY_API_KEY=
# Initial administrator only: required on an empty users database.
# Password must be 12–72 UTF-8 bytes. Once the administrator is created,
# remove these values and redeploy; existing accounts are never overwritten.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
